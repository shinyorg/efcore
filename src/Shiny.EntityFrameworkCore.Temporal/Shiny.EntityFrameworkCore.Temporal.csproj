<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>$(BaseTargetFramework)</TargetFramework>
        <Description>Provider-agnostic temporal history for EF Core - History, AsOf, Restore, diffs and per-actor audit trails on SQLite, PostgreSQL, SQL Server and MySQL.</Description>
        <PackageTags>$(PackageTags) temporal history audit versioning</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Shiny.EntityFrameworkCore.Temporal.Tests"/>
    </ItemGroup>
</Project>
